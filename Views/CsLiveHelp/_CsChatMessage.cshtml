@using Unified.Models.CsLiveHelp
@model CsRequest
@*
    Chat-mode wrapper around a request card. The card partial inside is the same one the
    kanban board uses, so every action (thread, move, escalate, edit, delete…) works the
    same in both modes; this partial only adds the "who sent it, when" chat chrome.

    ViewData:
      CardPartial   — card partial to render inside the bubble (required)
      IsMine        — true when the current user sent the request (aligned right)
      SenderLabel   — optional override for the sender name (e.g. hide other AMs' names)
*@
@{
    var cardPartial = (string)ViewData["CardPartial"]!;
    var isMine      = ViewData["IsMine"] is true;
    var sender      = ViewData["SenderLabel"] as string
                      ?? (isMine ? "You"
                          : Model.IsInternal ? "Internal request"
                          : Model.AccountManager?.DisplayName ?? Model.AccountManager?.UserName ?? "Deleted user");
    // Who picked it up — drives the ➕ reaction (✅ follows the status)
    var pickedBy = Model.AssignedTo?.DisplayName ?? Model.AssignedTo?.UserName;
    var initials = string.Concat(sender.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(w => char.ToUpperInvariant(w[0])));
}

<div class="cs-chat-msg @(isMine ? "cs-chat-msg-mine" : "")" data-chat-msg-id="@Model.Id"
     data-chat-status="@Model.Status" data-picked-by="@pickedBy">
    <div class="cs-chat-avatar @(Model.IsInternal ? "cs-chat-avatar-internal" : "")" title="@sender" aria-hidden="true">@initials</div>
    <div class="cs-chat-bubble">
        <div class="cs-chat-meta">
            <span class="fw-semibold">@sender</span>
            <span>@Model.CreatedAt.ToString("MMM dd, HH:mm") UTC</span>
        </div>
        <partial name="@cardPartial" model="Model" />
        @* Filled in by cslivehelp.js from data-chat-status / data-picked-by *@
        <div class="cs-chat-reactions"></div>
    </div>
</div>
