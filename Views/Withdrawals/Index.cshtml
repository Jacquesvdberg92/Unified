@using Unified.Models.Withdrawals
@using Unified.Services
@model Unified.Controllers.WithdrawalBoardViewModel
@*
    ── WD LIST (BETA) ──────────────────────────────────────────────────────

    A four-column board of client withdrawals. People pick a withdrawal up to show
    they are handling it, track missing documents (POI, POR, POD, CC, BD, CRP),
    link related tickets as free text and discuss it in the comment thread.
    Selecting a card (?id=) opens its detail panel on the right; every action
    posts back and returns here with the same filters. All of it is data-inplace,
    so only the page content is swapped (wwwroot/js/inplace.js), never the whole screen.
*@
@{
    ViewData["Title"] = "WD List";
    var statuses = new[] { WithdrawalStatus.Open, WithdrawalStatus.InProgress, WithdrawalStatus.WaitingOnClient, WithdrawalStatus.Done };
    var sel = Model.Selected;

    string BoardUrl(int? id) => Url.Action("Index", new
    {
        scope       = Model.Scope == WithdrawalService.Scope.All ? null : Model.Scope.ToString(),
        brandId     = Model.BrandId,
        q           = string.IsNullOrWhiteSpace(Model.Query) ? null : Model.Query,
        missingOnly = Model.MissingOnly ? true : (bool?)null,
        id
    })!;

    string HeaderClass(WithdrawalStatus s) => s switch
    {
        WithdrawalStatus.InProgress      => "bg-primary bg-opacity-10",
        WithdrawalStatus.WaitingOnClient => "bg-warning bg-opacity-10",
        WithdrawalStatus.Done            => "bg-success bg-opacity-10",
        _                                => "bg-secondary bg-opacity-10"
    };

    string BadgeClass(WithdrawalStatus s) => s switch
    {
        WithdrawalStatus.InProgress      => "bg-primary",
        WithdrawalStatus.WaitingOnClient => "bg-warning text-dark",
        WithdrawalStatus.Done            => "bg-success",
        _                                => "bg-secondary"
    };

    string Amount(WithdrawalRequest w) => w.Amount is decimal a
        ? $"{w.Currency} {a.ToString("N2", System.Globalization.CultureInfo.InvariantCulture)}".Trim()
        : "Amount not set";

    string Ago(DateTime utc)
    {
        var span = DateTime.UtcNow - utc;
        if (span.TotalMinutes < 1) return "just now";
        if (span.TotalHours   < 1) return $"{(int)span.TotalMinutes}m ago";
        if (span.TotalDays    < 1) return $"{(int)span.TotalHours}h ago";
        return $"{(int)span.TotalDays}d ago";
    }

    string Name(Unified.Models.Identity.AppUser? u) =>
        u is null ? "Unknown" : (string.IsNullOrWhiteSpace(u.DisplayName) ? u.UserName ?? "Unknown" : u.DisplayName);
}

<div class="container-fluid" data-inplace>

    @if (TempData["Error"] is string err)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bx bx-error-circle me-2"></i>@err
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Success"] is string ok)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bx bx-check-circle me-2"></i>@ok
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
        <h5 class="mb-0"><i class="bx bx-wallet me-2"></i>WD List</h5>
        <span class="badge bg-info text-dark">Beta</span>
        <span class="badge bg-primary ms-1">@Model.Items.Count(w => w.Status != WithdrawalStatus.Done) active</span>
        <button type="button" class="btn btn-primary btn-sm ms-auto" data-bs-toggle="modal" data-bs-target="#newWithdrawalModal">
            <i class="bx bx-plus me-1"></i>New withdrawal
        </button>
    </div>

    @* ── Filters ── *@
    <form method="get" class="card mb-3">
        <div class="card-body py-2 d-flex flex-wrap gap-2 align-items-center">
            <div class="btn-group btn-group-sm" role="group" aria-label="Show">
                @foreach (var (value, label) in new[] { (WithdrawalService.Scope.All, "All"), (WithdrawalService.Scope.Mine, "Picked up by me"), (WithdrawalService.Scope.Unassigned, "Unassigned") })
                {
                    <input type="radio" class="btn-check" name="scope" id="scope-@value" value="@value"
                           checked="@(Model.Scope == value)" onchange="this.form.requestSubmit()">
                    <label class="btn btn-outline-primary" for="scope-@value">@label</label>
                }
            </div>
            <label class="visually-hidden" for="wdBrand">Brand</label>
            <select id="wdBrand" name="brandId" class="form-select form-select-sm" style="max-width:200px" onchange="this.form.requestSubmit()">
                <option value="">All brands</option>
                @foreach (var b in Model.Brands)
                {
                    <option value="@b.Id" selected="@(Model.BrandId == b.Id)">@b.Name</option>
                }
            </select>
            <label class="visually-hidden" for="wdSearch">Search</label>
            <input id="wdSearch" type="search" name="q" value="@Model.Query" class="form-control form-control-sm" style="max-width:200px"
                   placeholder="CL ID or WD number" autocomplete="off">
            <div class="form-check form-check-inline mb-0 ms-1">
                <input class="form-check-input" type="checkbox" id="wdMissingOnly" name="missingOnly" value="true"
                       checked="@Model.MissingOnly" onchange="this.form.requestSubmit()">
                <label class="form-check-label small" for="wdMissingOnly">Only with missing documents</label>
            </div>
            <button type="submit" class="btn btn-primary btn-sm"><i class="bx bx-filter-alt me-1"></i>Apply</button>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Clear</a>
            @if (!string.IsNullOrWhiteSpace(Model.Query))
            {
                <span class="small text-muted">Searching includes older Done withdrawals.</span>
            }
        </div>
    </form>

    <div class="row g-3">

        @* ── Board ── *@
        <div class="@(sel is null ? "col-12" : "col-xl-8")">
            <div class="overflow-auto">
                <div class="row g-3 flex-nowrap" style="min-width:880px">
                    @foreach (var status in statuses)
                    {
                        var cards = Model.Items.Where(w => w.Status == status).ToList();
                        <div class="col">
                            <div class="card h-100">
                                <div class="card-header d-flex align-items-center gap-2 @HeaderClass(status)">
                                    <span class="fw-semibold">@status.ToLabel()</span>
                                    <span class="badge @BadgeClass(status) rounded-pill ms-auto">@cards.Count</span>
                                </div>
                                <div class="card-body p-2 d-flex flex-column gap-2" style="min-height:120px">
                                    @foreach (var w in cards)
                                    {
                                        var isSel  = sel?.Id == w.Id;
                                        var docs   = WithdrawalService.AllDocuments.Where(d => w.MissingDocuments.HasFlag(d)).ToList();
                                        var notes  = w.Comments.Count(c => !c.IsSystemMessage);
                                        var links  = string.IsNullOrWhiteSpace(w.RelatedTickets) ? 0 : w.RelatedTickets.Split('\n', StringSplitOptions.RemoveEmptyEntries).Length;
                                        <div class="card border shadow-sm p-2 small mb-0 @(isSel ? "border-primary border-2" : "")">
                                            <a href="@BoardUrl(w.Id)" class="text-reset text-decoration-none d-block">
                                                <div class="d-flex justify-content-between text-muted" style="font-size:.72rem">
                                                    <span>WD-@w.Id</span>
                                                    <span>@Ago(w.CreatedAt)</span>
                                                </div>
                                                <div class="fw-semibold">CL @w.ClientId</div>
                                                <div class="d-flex flex-wrap align-items-center gap-2">
                                                    <span class="badge bg-light text-dark border">@(w.Brand?.Name ?? "—")</span>
                                                    <span class="fw-medium">@Amount(w)</span>
                                                </div>
                                            </a>
                                            @if (docs.Any())
                                            {
                                                <div class="d-flex flex-wrap gap-1 mt-2">
                                                    @foreach (var d in docs)
                                                    {
                                                        <span class="badge bg-warning text-dark" title="@d missing">@d</span>
                                                    }
                                                </div>
                                            }
                                            <div class="d-flex align-items-center gap-2 border-top mt-2 pt-2">
                                                @if (w.AssignedTo is not null)
                                                {
                                                    <i class="bx bx-user-check text-primary" aria-hidden="true"></i>
                                                    <span class="text-truncate">@(w.AssignedToId == Model.CurrentUser ? "You" : Name(w.AssignedTo))</span>
                                                }
                                                else
                                                {
                                                    <form asp-action="PickUp" asp-route-id="@w.Id" method="post" class="m-0">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="returnUrl" value="@BoardUrl(w.Id)">
                                                        <button type="submit" class="btn btn-outline-primary btn-sm py-0">Pick up</button>
                                                    </form>
                                                }
                                                <span class="ms-auto text-muted d-flex gap-2" style="font-size:.72rem">
                                                    <span title="Comments"><i class="bx bx-message-rounded" aria-hidden="true"></i> @notes</span>
                                                    <span title="Related tickets"><i class="bx bx-link" aria-hidden="true"></i> @links</span>
                                                </span>
                                            </div>
                                        </div>
                                    }
                                    @if (!cards.Any())
                                    {
                                        <p class="text-muted small text-center mt-3 mb-0">Nothing here</p>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        @* ── Detail panel ── *@
        @if (sel is not null)
        {
            var mine = sel.AssignedToId == Model.CurrentUser;
            var here = BoardUrl(sel.Id);
            <div class="col-xl-4">
                <div class="card">
                    <div class="card-header d-flex align-items-start gap-2">
                        <div class="flex-grow-1">
                            <div class="text-muted small">WD-@sel.Id · opened @Ago(sel.CreatedAt) by @Name(sel.CreatedBy)</div>
                            <h6 class="mb-1 mt-1">CL @sel.ClientId</h6>
                            <span class="badge bg-light text-dark border">@(sel.Brand?.Name ?? "—")</span>
                            <span class="fw-semibold ms-2">@Amount(sel)</span>
                        </div>
                        <a href="@BoardUrl(null)" class="btn-close" aria-label="Close details"></a>
                    </div>
                    <div class="card-body d-flex flex-column gap-3">

                        @* Owner *@
                        <div class="d-flex flex-wrap align-items-center gap-2">
                            <span class="small text-muted">Handled by</span>
                            @if (sel.AssignedTo is not null)
                            {
                                <span class="fw-medium">@(mine ? "You" : Name(sel.AssignedTo))</span>
                                @if (mine)
                                {
                                    <form asp-action="Release" asp-route-id="@sel.Id" method="post" class="m-0">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="returnUrl" value="@here">
                                        <button type="submit" class="btn btn-outline-secondary btn-sm py-0">Release</button>
                                    </form>
                                }
                            }
                            else
                            {
                                <span class="text-muted">Nobody yet</span>
                                <form asp-action="PickUp" asp-route-id="@sel.Id" method="post" class="m-0">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="returnUrl" value="@here">
                                    <button type="submit" class="btn btn-primary btn-sm py-0">Pick up</button>
                                </form>
                            }
                        </div>

                        @* Status *@
                        <div>
                            <div class="small fw-semibold mb-1">Status</div>
                            <div class="d-flex flex-wrap gap-1">
                                @foreach (var s in statuses)
                                {
                                    <form asp-action="SetStatus" asp-route-id="@sel.Id" method="post" class="m-0">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="status" value="@s">
                                        <input type="hidden" name="returnUrl" value="@here">
                                        <button type="submit" class="btn btn-sm @(sel.Status == s ? BadgeClass(s).Replace("bg-", "btn-") : "btn-outline-secondary")"
                                                aria-pressed="@(sel.Status == s ? "true" : "false")">@s.ToLabel()</button>
                                    </form>
                                }
                            </div>
                        </div>

                        @* Documents *@
                        <div>
                            <div class="small fw-semibold mb-1">Documents <span class="fw-normal text-muted">(click to mark received or missing)</span></div>
                            <div class="row g-1">
                                @foreach (var d in WithdrawalService.AllDocuments)
                                {
                                    var missing = sel.MissingDocuments.HasFlag(d);
                                    <div class="col-4">
                                        <form asp-action="ToggleDocument" asp-route-id="@sel.Id" method="post" class="m-0">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="document" value="@d">
                                            <input type="hidden" name="returnUrl" value="@here">
                                            <button type="submit" class="btn btn-sm w-100 @(missing ? "btn-warning" : "btn-outline-success")">
                                                <span class="fw-semibold">@d</span> <span class="small">@(missing ? "missing" : "ok")</span>
                                            </button>
                                        </form>
                                    </div>
                                }
                            </div>
                        </div>

                        @* Amount + related tickets *@
                        <form asp-action="UpdateDetails" asp-route-id="@sel.Id" method="post" class="d-flex flex-column gap-2">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="returnUrl" value="@here">
                            <div class="row g-2">
                                <div class="col-8">
                                    <label class="form-label small fw-semibold mb-1" for="wdAmount">WD amount</label>
                                    <input id="wdAmount" type="number" name="amount" min="0.01" step="0.01" class="form-control form-control-sm"
                                           value="@sel.Amount?.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                                </div>
                                <div class="col-4">
                                    <label class="form-label small fw-semibold mb-1" for="wdCurrency">Currency</label>
                                    <input id="wdCurrency" type="text" name="currency" maxlength="3" class="form-control form-control-sm text-uppercase"
                                           value="@sel.Currency" placeholder="EUR">
                                </div>
                            </div>
                            <div>
                                <label class="form-label small fw-semibold mb-1" for="wdRelated">Related tickets</label>
                                <textarea id="wdRelated" name="relatedTickets" rows="3" maxlength="@WithdrawalService.MaxRelatedLength"
                                          class="form-control form-control-sm" placeholder="One link or ticket number per line">@sel.RelatedTickets</textarea>
                            </div>
                            <div class="text-end">
                                <button type="submit" class="btn btn-outline-primary btn-sm">Save details</button>
                            </div>
                        </form>

                        @* Comments *@
                        <div>
                            <div class="small fw-semibold mb-2">Comments</div>
                            <div class="d-flex flex-column gap-2 mb-2" style="max-height:360px;overflow-y:auto">
                                @foreach (var c in sel.Comments)
                                {
                                    if (c.IsSystemMessage)
                                    {
                                        <div class="text-muted text-center" style="font-size:.72rem">
                                            @Name(c.Author) @c.Body · @Ago(c.CreatedAt)
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="bg-light rounded p-2 small">
                                            <div><span class="fw-semibold">@Name(c.Author)</span> <span class="text-muted">@Ago(c.CreatedAt)</span></div>
                                            <div style="white-space:pre-wrap">@c.Body</div>
                                        </div>
                                    }
                                }
                            </div>
                            <form asp-action="AddComment" asp-route-id="@sel.Id" method="post" class="d-flex gap-2 align-items-end">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="returnUrl" value="@here">
                                <label class="visually-hidden" for="wdComment">Write a comment</label>
                                <textarea id="wdComment" name="body" rows="2" maxlength="@WithdrawalService.MaxCommentLength" required
                                          class="form-control form-control-sm" placeholder="Write a comment…"></textarea>
                                <button type="submit" class="btn btn-primary btn-sm">Post</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
        else if (Context.Request.Query.ContainsKey("id"))
        {
            <div class="col-12">
                <div class="alert alert-warning mb-0">That withdrawal could not be found.</div>
            </div>
        }
    </div>
</div>

@* ── New withdrawal modal ── *@
<div class="modal fade" id="newWithdrawalModal" tabindex="-1" aria-labelledby="newWithdrawalTitle" aria-hidden="true">
    <div class="modal-dialog">
        <form asp-action="Create" method="post" class="modal-content" data-inplace>
            @Html.AntiForgeryToken()
            <div class="modal-header">
                <h6 class="modal-title" id="newWithdrawalTitle">New withdrawal</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body d-flex flex-column gap-3">
                <div class="row g-2">
                    <div class="col-6">
                        <label class="form-label small fw-semibold mb-1" for="newClientId">CL ID <span class="text-danger">*</span></label>
                        <input id="newClientId" name="clientId" class="form-control form-control-sm" maxlength="100" required autocomplete="off">
                    </div>
                    <div class="col-6">
                        <label class="form-label small fw-semibold mb-1" for="newBrand">Brand <span class="text-danger">*</span></label>
                        <select id="newBrand" name="brandId" class="form-select form-select-sm" required>
                            <option value="">Choose a brand</option>
                            @foreach (var b in Model.Brands)
                            {
                                <option value="@b.Id" selected="@(Model.BrandId == b.Id)">@b.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-8">
                        <label class="form-label small fw-semibold mb-1" for="newAmount">WD amount <span class="text-muted fw-normal">(optional)</span></label>
                        <input id="newAmount" type="number" name="amount" min="0.01" step="0.01" class="form-control form-control-sm">
                    </div>
                    <div class="col-4">
                        <label class="form-label small fw-semibold mb-1" for="newCurrency">Currency</label>
                        <input id="newCurrency" name="currency" maxlength="3" class="form-control form-control-sm text-uppercase" placeholder="EUR">
                    </div>
                </div>
                <fieldset>
                    <legend class="form-label small fw-semibold mb-1">Missing documents <span class="text-muted fw-normal">(tick what the client still owes)</span></legend>
                    <div class="d-flex flex-wrap gap-3">
                        @foreach (var d in WithdrawalService.AllDocuments)
                        {
                            <div class="form-check mb-0">
                                <input class="form-check-input" type="checkbox" name="missing" value="@d" id="newDoc-@d">
                                <label class="form-check-label small fw-semibold" for="newDoc-@d">@d</label>
                            </div>
                        }
                    </div>
                </fieldset>
                <div>
                    <label class="form-label small fw-semibold mb-1" for="newRelated">Related tickets</label>
                    <textarea id="newRelated" name="relatedTickets" rows="2" maxlength="@WithdrawalService.MaxRelatedLength" class="form-control form-control-sm"
                              placeholder="One link or ticket number per line, on or off the platform"></textarea>
                </div>
                <div>
                    <label class="form-label small fw-semibold mb-1" for="newComment">First comment <span class="text-muted fw-normal">(optional)</span></label>
                    <textarea id="newComment" name="firstComment" rows="2" maxlength="@WithdrawalService.MaxCommentLength" class="form-control form-control-sm"
                              placeholder="What does the client want, and what is holding it up?"></textarea>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="pickUp" value="true" id="newPickUp" checked>
                    <label class="form-check-label small" for="newPickUp">Pick it up myself</label>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-primary btn-sm">Create withdrawal</button>
            </div>
        </form>
    </div>
</div>
