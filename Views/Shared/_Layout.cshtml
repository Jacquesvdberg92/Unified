<!DOCTYPE html>
<html lang="en" dir="ltr" data-nav-layout="vertical" data-theme-mode="light" data-header-styles="light" data-menu-styles="dark" data-toggled="close">

    <head>

        <!-- META DATA -->
		<meta charset="UTF-8">
        <meta name='viewport' content='width=device-width, initial-scale=1.0'>
        <meta http-equiv="X-UA-Compatible" content="IE=edge">
        <meta name="Description" content="Unified — Internal operations tool">

		<!-- TITLE -->
		<title>@ViewData["Title"] — Unified</title>

        <!-- THEME SYNC: mirror the theme's dark mode onto Bootstrap's colour mode so Bootstrap
             components (tables, *-subtle badges, close buttons, selects) follow it too -->
        <script>
            (function () {
                var html = document.documentElement;
                function sync() { html.setAttribute('data-bs-theme', html.getAttribute('data-theme-mode') === 'dark' ? 'dark' : 'light'); }
                sync();
                new MutationObserver(sync).observe(html, { attributes: true, attributeFilter: ['data-theme-mode'] });
            })();
        </script>

        <!-- ERROR CAPTURE: keep the last few browser errors so Report a bug can attach them -->
        <script>
            (function () {
                var key = 'unified.recentErrors';
                function remember(text) {
                    try {
                        var list = JSON.parse(sessionStorage.getItem(key) || '[]');
                        list.push(new Date().toISOString() + ' ' + location.pathname + ' ' + String(text).slice(0, 400));
                        sessionStorage.setItem(key, JSON.stringify(list.slice(-10)));
                    } catch (_) { }
                }
                window.addEventListener('error', function (e) {
                    remember((e.message || 'Error') + (e.filename ? ' (' + e.filename + ':' + e.lineno + ':' + e.colno + ')' : ''));
                });
                window.addEventListener('unhandledrejection', function (e) {
                    remember('Unhandled promise rejection: ' + (e.reason && (e.reason.stack || e.reason.message) || e.reason));
                });
                var original = console.error;
                function describe(a) {
                    if (a instanceof Error) return a.stack || a.message;
                    if (a && typeof a === 'object') { try { return JSON.stringify(a); } catch (_) { return String(a); } }
                    return a;
                }
                console.error = function () {
                    remember(Array.prototype.map.call(arguments, describe).join(' '));
                    return original.apply(console, arguments);
                };
            })();
        </script>

		<!-- FAVICON -->
        <link rel="icon" type="image/png" href="@Url.Content("~/fav.png")">

        <!-- BOOTSTRAP CSS -->
	    <link  id="style" href="@Url.Content("~/assets/libs/bootstrap/css/bootstrap.min.css")" rel="stylesheet">

        <!-- STYLES CSS -->
        <link href="@Url.Content("~/assets/css/styles.css")" rel="stylesheet">

        <!-- ICONS CSS -->
        <link href="@Url.Content("~/assets/css/icons.css")" rel="stylesheet">
        
        <partial name="~/Views/Shared/Layouts/_styles.cshtml">

        <!-- SITE CSS -->
        <link rel="stylesheet" href="@Url.Content("~/css/site.css")" asp-append-version="true">

        <!-- MAIN JS -->
        <script src="@Url.Content("~/assets/js/main.js")" defer></script>

		@await RenderSectionAsync("Styles", required: false)

		<!-- TOASTIFY CSS -->
		<link rel="stylesheet" href="@Url.Content("~/assets/libs/toastify-js/src/toastify.css")">

	</head>

	<body>

        <!-- SWITCHER -->
        <partial name="~/Views/Shared/Layouts/_switcher.cshtml">
        <!-- END SWITCHER -->

        <!-- LOADER -->
		<div id="loader">
            <div class="spinner-border text-primary" role="status" aria-label="Loading"></div>
		</div>
		<!-- END LOADER -->

        <!-- PAGE -->
		<div class="page">

            <!-- HEADER -->
            <partial name="~/Views/Shared/Layouts/_header.cshtml">

            <!-- END HEADER -->

            <!-- SIDEBAR -->

            <partial name="~/Views/Shared/Layouts/_sidebar.cshtml">

            <!-- END SIDEBAR -->

            <!-- MAIN-CONTENT -->

            <div class="main-content app-content">
                <div class="container-fluid">
                    <partial name="~/Views/Shared/_Breadcrumbs.cshtml" />
                    @RenderBody()
                </div>
            </div>
            <!-- END MAIN-CONTENT -->

            <!-- FOOTER -->
            <partial name="~/Views/Shared/Layouts/_footer.cshtml">

            <!-- END FOOTER -->

		</div>
        <!-- END PAGE-->

        <!-- SCRIPTS -->

        <partial name="~/Views/Shared/Layouts/_scripts.cshtml">

        <!-- TOASTIFY JS -->
        <script src="@Url.Content("~/assets/libs/toastify-js/src/toastify.js")" defer></script>

        @await RenderSectionAsync("Scripts", required: false)

        <partial name="~/Views/Shared/_Toast.cshtml" />

        <partial name="~/Views/Shared/_PinnedUpdatesToast.cshtml" />

		<!-- STICKY JS -->
		<script src="@Url.Content("~/assets/js/sticky.js")" defer></script>

		<!-- DASHBOARD WIDGETS JS -->
		<script src="@Url.Content("~/js/dashboard-widgets.js")" asp-append-version="true" defer></script>

		<!-- CUSTOM JS -->
		<script src="@Url.Content("~/assets/js/custom.js")" defer></script>

		<!-- CUSTOM-SWITCHER JS -->
		<script src="@Url.Content("~/assets/js/custom-switcher.js")" defer></script>

        <!-- END SCRIPTS -->

	</body>
</html>
