@{
    var success = TempData["Success"] as string;
    var warning = TempData["Warning"] as string;
    var error   = TempData["Error"]   as string;
}
@if (success != null || warning != null || error != null)
{
    @* Read by inplace.js, both on page load and after an in-place update *@
    <script type="application/json" id="tempDataToasts">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(new { success, warning, error }))</script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            window.unifiedInplace?.showToastsFrom(document);
        });
    </script>
}
